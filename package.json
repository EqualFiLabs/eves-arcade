{
  "name": "rug-pull-rumble",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Proof of Fight V1 — a Sminem vs Bogdanoff crypto-parody Phaser 4 fighting game.",
  "scripts": {
    "dev": "pnpm --filter @rpr/web dev",
    "dev:api": "pnpm --filter @rpr/api dev",
    "dev:ranked": "pnpm --parallel --filter @rpr/api --filter @rpr/web dev",
    "build": "pnpm --filter @rpr/web build",
    "build:api": "pnpm --filter @rpr/api build",
    "build:all": "pnpm build:api && pnpm build",
    "preview": "pnpm --filter @rpr/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:sim": "vitest run tests/sim",
    "test:architecture": "vitest run tests/architecture",
    "test:api:integration": "bash scripts/test-postgres.sh",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check:bundle": "bash scripts/check-production-bundle.sh",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build:all && pnpm check:bundle",
    "check:all": "pnpm check:fast && pnpm test:api:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@rpr/content": "workspace:*",
    "@rpr/controls": "workspace:*",
    "@rpr/protocol": "workspace:*",
    "@rpr/rug-pull-rumble-core": "workspace:*",
    "@rpr/sim": "workspace:*",
    "@types/node": "^22.8.0",
    "eslint": "^9.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
